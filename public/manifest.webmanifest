{
  "name": "Choco Quick Search",
  "short_name": "ChocoSearch",
  "description": "Quick search box for Chocolatey community packages",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1a1008",
  "theme_color": "#2b1a0e",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
